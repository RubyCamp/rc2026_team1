<% content_for :title, "Rails開発チュートリアル" %>
<!-- Hello World -->
<h1>List Views</h1>
<% if @work_requests.any? %>
  <div class="row g-4">
    <% @work_requests.each do |work_request| %>
      <div class="col-12 col-md-6 col-xl-4">
        <article
          class="card work-request-card h-100 shadow-sm"
        >
          <div class="card-body">
            <div
              class="
                d-flex
                justify-content-between
                align-items-center
                gap-3
                mb-3
              "
            >
              <span class="badge text-bg-primary">
                <%= enum_label(work_request, :status) %>
              </span>

              <small class="text-body-secondary">
                <%= l work_request.starts_at,
                      format: :short %>
              </small>
            </div>

            <h2 class="h5 card-title">
              <%= link_to(
                    work_request.title,
                    work_request,
                    class: "link-dark stretched-link"
                  ) %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>事業者</dt>
                <dd><%= work_request.business.name %></dd>
              </div>

              <div>
                <dt>必要人数</dt>
                <dd>
                  <%= work_request.required_staff_count %>名
                </dd>
              </div>

              <div>
                <dt>割当済み</dt>
                <dd>
                  <%= work_request.assignments.size %>名
                </dd>
              </div>

              <div>
                <dt>必要スキル</dt>
                <dd>
                  <%= work_request.required_skill&.name ||
                      "指定なし" %>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    勤務依頼はまだ登録されていません。
  </div>
<% end %>
