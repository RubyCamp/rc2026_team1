<% content_for :title, @work_request.title %>

<p>
  <%= link_to(
        "勤務依頼一覧へ戻る",
        work_requests_path,
        class: "link-secondary"
      ) %>
</p>

<div
  class="
    d-flex
    flex-column
    flex-md-row
    justify-content-between
    align-items-md-start
    gap-3
    mb-4
  "
>
  <div>
    <p class="mb-1 text-primary fw-semibold">
      <%= @work_request.business.name %>
    </p>

    <h1 class="display-6 fw-bold">
      <%= @work_request.title %>
    </h1>

    <p class="text-body-secondary">
      <%= l @work_request.starts_at, format: :long %>
      〜
      <%= l @work_request.ends_at, format: :long %>
    </p>
  </div>

  <span class="badge text-bg-primary">
    <%= enum_label(@work_request, :status) %>
  </span>
</div>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 card-title">
      依頼条件
    </h2>

    <dl class="definition-list mb-0">
      <div>
        <dt>必要人数</dt>
        <dd>
          <%= @work_request.required_staff_count %>名
        </dd>
      </div>

      <div>
        <dt>必要スキル</dt>
        <dd>
          <%= @work_request.required_skill&.name ||
              "指定なし" %>
        </dd>
      </div>

      <div>
        <dt>割当済み</dt>
        <dd>
          <%= @work_request.assignments.size %>名
        </dd>
      </div>

      <div>
        <dt>勤務時間</dt>
        <dd>
          <%= l @work_request.starts_at, format: :long %>
          〜
          <%= l @work_request.ends_at, format: :long %>
        </dd>
      </div>
    </dl>
  </div>
</section>

<section class="card shadow-sm mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
      <h2 class="h4 card-title mb-0">備考</h2>
      <%= link_to "備考を編集", edit_work_request_path(@work_request), class: "btn btn-outline-primary" %>
    </div>

    <% if @work_request.notes.present? %>
      <%= simple_format @work_request.notes, class: "mb-0" %>
    <% else %>
      <p class="mb-0 text-body-secondary">備考はありません。</p>
    <% end %>
  </div>
</section>

<section class="card shadow-sm">
  <div class="card-body">
    <h2 class="h4 card-title">
      現在の割当
    </h2>

    <div class="border-bottom pb-4 mb-4">
      <h3 class="h5">スタッフを仮割り当て</h3>
      <% if @assignable_staff_members.any? %>
        <div class="dropdown">
          <button
            class="btn btn-outline-primary dropdown-toggle w-100 text-start"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            スタッフを選択
          </button>
          <ul class="dropdown-menu w-100">
            <% @assignable_staff_members.each do |staff_member| %>
              <% skill_missing = staff_member.skills.none? { |skill| skill.id == @work_request.required_skill_id } %>
              <% time_conflict = Assignment.time_conflict_for?(work_request_id: @work_request.id, staff_member_id: staff_member.id) %>
              <li>
                <%= button_to assign_work_request_path(@work_request),
                  method: :post,
                  params: { staff_member_id: staff_member.id },
                  class: "dropdown-item d-flex justify-content-between align-items-center gap-3",
                  form: { class: "m-0" } do %>
                  <span>
                    <strong><%= staff_member.name %></strong>
                    <span class="text-body-secondary ms-2">
                      <%= staff_member.skills.map(&:name).join("、").presence || "スキルなし" %>
                    </span>
                  </span>
                  <% if skill_missing || time_conflict %>
                    <span class="d-flex gap-1">
                      <% if skill_missing %>
                        <span class="badge text-bg-danger">スキル不足</span>
                      <% end %>
                      <% if time_conflict %>
                        <span class="badge text-bg-danger">時間重複</span>
                      <% end %>
                    </span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="mb-0 text-body-secondary">割り当て可能なスタッフはいません。</p>
      <% end %>
    </div>

    <% if @work_request.assignments.any? %>
      <ul class="list-group list-group-flush">
        <% @work_request.assignments.each do |assignment| %>
          <% skill_missing = !StaffMember.skilled_for(work_request_id: @work_request.id).exists?(id: assignment.staff_member_id) %>
          <% time_conflict = Assignment.time_conflict?(id: assignment.id) %>
          <% has_warning = skill_missing || time_conflict %>
          <li
            class="
              list-group-item
              px-0
              d-flex
              justify-content-between
              <%= "list-group-item-danger" if has_warning %>
              align-items-center
              gap-3
            "
          >
            <div>
              <strong>
                <%= assignment.staff_member.name %>
              </strong>

              <% if has_warning %>
                <div class="mt-1">
                  <% if skill_missing %>
                    <span class="badge text-bg-danger">スキル不足</span>
                  <% end %>
                  <% if time_conflict %>
                    <span class="badge text-bg-danger">時間重複</span>
                  <% end %>
                </div>
              <% end %>
            </div>

            <span class="badge text-bg-secondary">
              <%= enum_label(assignment, :status) %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mb-0 text-body-secondary">
        まだスタッフは割り当てられていません。
      </p>
    <% end %>
  </div>
</section>
