<% content_for :title, "未確定一覧" %>
<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    勤務調整
  </p>

  <h1 class="display-6 fw-bold">
    未確定依頼一覧
  </h1>

  <p class="page-lead text-body-secondary">
    依頼内容と現在の割当状況を確認できます。
  </p>
</div>

<div class="container">
  <div class="row align-items-start">
    <div class="col-sm-8">
<% if @work_requests.any? %>
  <div class="row g-4">
    <% @work_requests.each do |work_request| %>
      <div class="col-12 col-md-6 col-xl-4">
        <article
          class="card work-request-card h-100 shadow-sm"
        >
          <div class="card-body">
            <div
              class="
                d-flex
                justify-content-between
                align-items-center
                gap-3
                mb-3
              "
            >
              <span class="badge text-bg-primary">
                <%= enum_label(work_request, :status) %>
              </span>

              <small class="text-body-secondary">
                <%= l work_request.starts_at,
                      format: :short %>
              </small>
            </div>

            <h2 class="h5 card-title">
              <%= link_to(
                    work_request.title,
                    work_request,
                    class: "link-dark stretched-link"
                  ) %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>事業者</dt>
                <dd><%= work_request.business.name %></dd>
              </div>

              <div>
                <dt>必要人数</dt>
                <dd>
                  <%= work_request.required_staff_count %>名
                </dd>
              </div>

              <div>
                <dt>割当済み</dt>
                <dd>
                  <%= work_request.assignments.size %>名
                </dd>
              </div>

              <div>
                <dt>必要スキル</dt>
                <dd>
                  <%= work_request.required_skill&.name ||
                      "指定なし" %>
                </dd>
              </div>
            </dl>
            <%#= button_to "確定済み", {} %>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
      <div class="alert alert-info">
        勤務依頼はまだ登録されていません。
      </div>
<% end %>
    </div>
    <div class="col">
      <% if @staff_members.any? %>
  <div class="row g-4">
    <% @staff_members.each do |staff_member| %>
      <div class="col-12 col-md-6">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <span class="badge text-bg-secondary mb-3">
              <%= enum_label(
                    staff_member,
                    :employment_status
                  ) %>
            </span>

            <h2 class="h5 card-title">
              <%= staff_member.name %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>スキル</dt>
                <dd>
                  <%= staff_member.skills
                        .map(&:name)
                        .join("、")
                        .presence || "なし" %>
                </dd>
              </div>

              <div>
                <dt>勤務予定</dt>
                <dd>
                  <%= staff_member.availabilities
                        .map do |availability|
                          enum_label(
                            availability,
                            :status
                          )
                        end
                        .join("、")
                        .presence || "未登録" %>
                </dd>
              </div>
            </dl>
          </div>
        </article>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    スタッフはまだ登録されていません。
  </div>
<% end %>
    </div>
  </div>
</div>
