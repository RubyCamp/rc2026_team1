<%= content_for :title, "スタッフ一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    スタッフ管理
  </p>

  <h1 class="display-6 fw-bold">
    スタッフ一覧
  </h1>

  <p class="page-lead text-body-secondary">
    在籍状況・スキル・勤務可否を確認できます。
  </p>
</div>

<% if @staff_members.any? %>
  <div class="row g-4">
    <% @staff_members.each do |staff_member| %>
      <div class="col-12 col-md-6">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <span class="badge text-bg-secondary mb-3">
              <%= enum_label(
                    staff_member,
                    :employment_status
                  ) %>
            </span>

            <h2 class="h5 card-title">
              <%= staff_member.name %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>スキル</dt>
                <dd>
                  <%= staff_member.skills
                        .map(&:name)
                        .join("、")
                        .presence || "なし" %>
                </dd>
              </div>

              <div>
                <dt>勤務予定</dt>
                <dd>
                  <%= staff_member.availabilities
                        .map do |availability|
                          enum_label(
                            availability,
                            :status
                          )
                        end
                        .join("、")
                        .presence || "未登録" %>
                </dd>
              </div>
            </dl>
            <div class="mt-auto pt-3 border-top">
              <button type="button"
                      class="btn btn-outline-primary btn-sm w-100"
                      data-bs-toggle="modal"
                      data-bs-target="#shiftModal-<%= staff_member.id %>">
                      シフトカレンダーを見る
              </button>
            </div>
          </div>
        </article>
        <div class="modal fade" id="shiftModal-<%= staff_member.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><%= staff_member.name %> さんのシフト
                </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                  </button>
                </div>
                <div class="modal-body">
                  <div class="table-responsive">
                    <table class="table table-bordered text-center aligh-middle mb-0">
                      <thead class="table-light">
                        <tr>
                          <th class="text-danger">日
                          </th>
                          <th>月
                          </th>
                          <th>火
                          </th>
                          <th>水
                          </th>
                          <th>木
                          </th>
                          <th>金
                          </th>
                          <th class="text-primary">土
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr style="height: 80px;">
                          <td class"text-secondary aligh-top text-start fs-7">1
                          </td>
                          <td class"text-secondary aligh-top text-start fs-7">2
                          </td>
                          <td class"text-secondary aligh-top text-start fs-7">3
                            <span class="badge bg-success-subtle text-success border border-success d-block mt-1">出勤
                            </span>
                          </td>
                          <td class="text-secondary align-top text-start fs-7">4
                          </td>
                          <td class="text-secondary align-top text-start fs-7">5
                            <span class="badge bg-success-subtle text-success border border-success d-block mt-1">出勤
                            </span>
                          </td>
                          <td class="text-secondary align-top text-start fs-7">6
                          </td>
                          <td class="text-secondary align-top text-start fs-7">7
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">閉じる
                  </button>
                </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    スタッフはまだ登録されていません。
  </div>
<% end %>
