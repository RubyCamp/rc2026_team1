<div id="assignment-status-<%= assignment.id %>" class="d-inline">
  <% if assignment.draft? %>
    <% work_request = assignment.work_request %>
    <% confirmation_issues = [] %>
    <% skill_missing = !StaffMember.skilled_for(work_request_id: work_request.id).exists?(id: assignment.staff_member_id) %>
    <% confirmation_issues << "スキル不足" if skill_missing %>
    <% confirmation_issues << "人数不足" unless work_request.staffing_sufficient? %>

    <% if confirmation_issues.any? %>
      <button type="button" class="badge border-0 text-bg-danger me-2" disabled>
        仮割り当て（<%= confirmation_issues.join("・") %>）
      </button>
    <% else %>
      <%= button_to "仮割り当て",
        confirm_list_view_path(assignment),
        method: :patch,
        params: { modal_toggle: true },
        class: "badge border-0 text-bg-warning me-2",
        form: { class: "d-inline", data: { turbo_stream: true } } %>
    <% end %>
  <% else %>
    <%= button_to "確定済み",
      unconfirm_list_view_path(assignment),
      method: :patch,
      params: { modal_toggle: true },
      class: "badge border-0 text-bg-primary me-2",
      form: { class: "d-inline", data: { turbo_stream: true } } %>
  <% end %>
</div>
