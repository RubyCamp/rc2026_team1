<%= content_for :title, "スタッフ一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    スタッフ管理
  </p>

  <h1 class="display-6 fw-bold">
    スタッフ一覧
  </h1>

  <p class="page-lead text-body-secondary">
    在籍状況・スキル・勤務可否を確認できます。
  </p>
</div>

<% if @staff_members.any? %>
  <div class="row g-4">
    <% @staff_members.each do |staff_member| %>
      <div class="col-12 col-md-6">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <span class="badge text-bg-secondary mb-3">
              <%= enum_label(
                    staff_member,
                    :employment_status
                  ) %>
            </span>

            <h2 class="h5 card-title">
              <%= staff_member.name %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>スキル</dt>
                <dd>
                  <%= staff_member.skills
                        .map(&:name)
                        .join("、")
                        .presence || "なし" %>
                </dd>
              </div>

              <div>
                <dt>勤務予定</dt>
                <dd>
                  <%= staff_member.availabilities
                        .map do |availability|
                          enum_label(
                            availability,
                            :status
                          )
                        end
                        .join("、")
                        .presence || "未登録" %>
                </dd>
              </div>
            </dl>
            <div class="mt-auto pt-3 border-top">
              <button type="button"
                      class="btn btn-outline-primary btn-sm w-100"
                      data-bs-toggle="modal"
                      data-bs-target="#shiftModal-<%= staff_member.id %>">
                      シフトを見る
              </button>
            </div>
          </div>
        </article>
        <div class="modal fade" id="shiftModal-<%= staff_member.id %>" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><%= staff_member.name %> さんのシフト
                </h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                  </button>
                </div>
                <div class="modal-body">
                  <% if staff_member.availabilities.any? || staff_member.assignments.any? %>
                  <div class="list-group">
                    <% Availability.for_staff(staff_member_id: staff_member.id).each do |availability| %>
                      <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                          <span class="badge text-bg-secondary me-2">
                            <%= enum_label(availability, :status) %>
                          </span>
                          <strong><%= availability.starts_at.strftime("%Y/%m/%d") %></strong>
                        </div>
                        <span class="text-body-secondary small">
                          <%= availability.starts_at.strftime("%H:%M") %> ~ <%= availability.ends_at.strftime("%H:%M") %>
                        </span>
                      </div>
                    <% end %>
                    <% staff_member.assignments.sort_by { |assignment| assignment.work_request.starts_at }.each do |assignment| %>
                      <% work_request = assignment.work_request %>
                      <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                          <span class="badge <%= assignment.draft? ? 'text-bg-warning' : 'text-bg-primary' %> me-2">
                            <%= assignment.draft? ? "仮割り当て" : "確定済み" %>
                          </span>
                          <strong><%= work_request.title %></strong>
                        </div>
                        <span class="text-body-secondary small">
                          <%= work_request.starts_at.strftime("%Y/%m/%d %H:%M") %> ~
                          <%= work_request.ends_at.strftime("%H:%M") %>
                        </span>
                      </div>
                    <% end %>
                  </div>
                  <% else %>
                  <p class="text-muted mb-0">勤務予定はまだ登録されていません。
                  </p>
                  <% end %>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">閉じる
                  </button>
                </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    スタッフはまだ登録されていません。
  </div>
<% end %>
