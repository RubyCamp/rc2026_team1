<%= content_for :title, "スタッフ一覧" %>

<div class="mb-4">
  <p class="mb-1 text-primary fw-semibold">
    スタッフ管理
  </p>

  <h1 class="display-6 fw-bold">
    スタッフ一覧
  </h1>

  <p class="page-lead text-body-secondary">
    在籍状況・スキル・勤務可否を確認できます。
  </p>
</div>

<% if @staff_members.any? %>
  <div class="row g-4">
    <% @staff_members.each do |staff_member| %>
      <div class="col-12 col-md-6">
        <article class="card h-100 shadow-sm">
          <div class="card-body">
            <span class="badge <%= staff_member.inactive? ? "text-bg-danger" : "text-bg-secondary" %> mb-3">
              <%= enum_label(
                    staff_member,
                    :employment_status
                  ) %>
            </span>

            <h2 class="h5 card-title">
              <%= staff_member.name %>
            </h2>

            <dl class="definition-list mb-0">
              <div>
                <dt>スキル</dt>
                <dd>
                  <%= staff_member.skills
                        .map(&:name)
                        .join("、")
                        .presence || "なし" %>
                </dd>
              </div>

              <div>
                <dt>勤務予定</dt>
                <dd>
                  <% if staff_member.availabilities.any? %>
                    <% staff_member.availabilities.each do |availability| %>
                      <% availability_class = if availability.unavailable?
                                                "text-bg-danger"
                                              elsif staff_member.inactive?
                                                "text-bg-warning"
                                              else
                                                "text-bg-primary"
                                              end %>
                      <span
                        class="badge <%= availability_class %>"
                        aria-label="<%= enum_label(availability, :status) %>"
                        title="<%= enum_label(availability, :status) %>"
                      >
                        <%= availability.available? ? "○" : "×" %>
                      </span>
                    <% end %>
                  <% else %>
                    未登録
                  <% end %>
                </dd>
              </div>
            </dl>
            <div class="mt-auto pt-3 border-top">
              <button type="button"
                      class="btn btn-outline-primary btn-sm w-100"
                      data-bs-toggle="modal"
                      data-bs-target="#shiftModal-<%= staff_member.id %>">
                      シフトを見る
              </button>
            </div>
          </div>
        </article>
        <%= render "shared/shift_modal",
          staff_member: staff_member,
          modal_id: "shiftModal-#{staff_member.id}" %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="alert alert-info">
    スタッフはまだ登録されていません。
  </div>
<% end %>
